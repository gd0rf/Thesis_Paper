@article{zhangLEOMegaConstellations2022,
  title = {{{LEO Mega Constellations}}: {{Review}} of {{Development}}, {{Impact}}, {{Surveillance}}, and {{Governance}}},
  shorttitle = {{{LEO Mega Constellations}}},
  author = {Zhang, Jingrui and Cai, Yifan and Xue, Chenbao and Xue, Zhirun and Cai, Han},
  date = {2022-01},
