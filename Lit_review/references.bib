@article{leeEnhancedRealTimeOnboard2025,
  title = {Enhanced {{Real-Time Onboard Orbit Determination}} of {{LEO Satellites Using GPS Navigation Solutions}} with {{Signal Transit Time Correction}}},
  author = {Lee, Daero and Hwang, Soon Sik},
  date = {2025-06},
  journaltitle = {Aerospace},
  volume = {12},
